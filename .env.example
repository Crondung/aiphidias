# Vorlage. Die echte .env gehoert nicht ins Repo (siehe .gitignore).

# --- Zielserver (Deployment) -------------------------------------------
SERVER_IP=
SERVER_USER=
SERVER_PASSWORD=

# --- Anwendung ---------------------------------------------------------
DATABASE_URL=postgresql://aiphidias:CHANGEME@postgres:5432/aiphidias
BLOB_ROOT=/var/lib/aiphidias/blobs
PUBLIC_BASE_URL=https://aiphidias.art
MCP_BASE_URL=https://mcp.aiphidias.art

# Schluessel der Upload-Signatur. Erzeugen mit: openssl rand -hex 32
HMAC_SECRET=

# Identitaet aus einem HTTP-Header statt aus OAuth. Ausschliesslich lokal.
DEV_MODE=false
